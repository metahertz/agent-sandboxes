          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(aio_workspace_info, workspace)",
          "refId": "ws"
        },
        "definition": "label_values(aio_workspace_info, workspace)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
