    {
      "type": "stat",
      "title": "Tokens",
      "description": "All token types, selected time range",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum (sum_over_time({service_name=\"claude-code\", workspace=~\"$workspace\"} | event_name=\"api_request\" | unwrap input_tokens [$__range])) + sum (sum_over_time({service_name=\"claude-code\", workspace=~\"$workspace\"} | event_name=\"api_request\" | unwrap output_tokens [$__range])) + sum (sum_over_time({service_name=\"claude-code\", workspace=~\"$workspace\"} | event_name=\"api_request\" | unwrap cache_read_tokens [$__range])) + sum (sum_over_time({service_name=\"claude-code\", workspace=~\"$workspace\"} | event_name=\"api_request\" | unwrap cache_creation_tokens [$__range]))",
          "queryType": "instant"
        }
      ],
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
