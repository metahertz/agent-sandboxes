#!/usr/bin/env python3
"""agent-sandboxes Mac build worker: takes jobs from the build host (aio-buildd)
and runs each in a throwaway Tart VM.

It only ever connects out, over ssh, with a key that may do nothing but fetch
the job, claim it, send its log and heartbeats, and push its result
(refs/results/<id>). Per job:

  1. fetch the job's commit (tag build/<id>) into a fresh checkout here
  2. tart clone <image> aio-<ws>-<id>; tart run it with the checkout shared
     read-only and an output folder shared read-write
  3. tart exec: copy the source in, run the fixed xcodebuild steps for the
     job's action (build, test, run = build + launch in the Simulator +
     screenshots, screenshots = the UI tests' screenshot attachments,
     archive = an ad-hoc signed .xcarchive), copy the outputs out
  4. push summary.json, build.log, test-summary.json and screenshots/ as
     refs/results/<id>; upload a zipped archive or an .ipa as an artifact.
     The output folder is the VM's to write: every file is read from it
     with O_NOFOLLOW, so a symlink there can't hand over a file of this Mac
  5. stop and delete the VM, remove the checkout

An export job signs an archive job's .xcarchive with an identity from the
UI (Keys & tokens -> Apple signing), and can upload it to App Store
Connect. No project code runs: the VM gets the archive and the keys, and
runs xcodebuild -exportArchive. The keys come sealed for this worker: the
UI encrypts them to its seal key (~/.aio-build/seal.pem, RSA; its public half
is signed with the worker's ssh key, which the UI checks), and the build
host only ever holds ciphertext. They're unsealed into the job's folder
(0700), shared read-only into the VM, and deleted with it.

The job's code runs only inside the VM; nothing from this Mac goes in but the
checkout. Python 3.9+ (the one with Xcode's command line tools will do).

  aio-build-worker [--config ~/.aio-build/config.json] [--once]
"""
from __future__ import annotations

import argparse
import collections
import json
import os
import re
import shlex
import shutil
import socket
import subprocess
import sys
import tempfile
import threading
import time
from pathlib import Path

VERSION = "3"
CONFIG = Path(os.environ.get("AIO_BUILD_CONFIG", "~/.aio-build/config.json")).expanduser()
DEFAULTS = {
    "name": "", "host": "", "port": 22,
    "key": "~/.aio-build/worker_ed25519", "known_hosts": "~/.aio-build/known_hosts",
    "image": "ghcr.io/cirruslabs/macos-sequoia-xcode:latest",
    "max_vms": 1,                       # Apple's licence: at most 2 macOS VMs per Mac
    "tart": "tart",
    "run_args": ["--no-graphics"],      # e.g. "--net-softnet" to keep the VM off your LAN
    "vm_env": {},                       # e.g. {"HTTPS_PROXY": "http://proxy.lan:3128"}
    "poll_seconds": 10, "boot_timeout": 300,
    "work": "~/.aio-build/work",
    "share_root": "/Volumes/My Shared Files",   # where macOS guests see tart run --dir shares
    "ssh_args": [],                     # more ssh options, e.g. ["-F", "/dev/null"] to ignore ~/.ssh/config
}
MAX_RESULT_LOG = 5 << 20

# Same rules as aio-buildd's check (it refused anything else at push time;
# checked again because the commands below are built from these strings)
SPEC_RULES = {
    "action": re.compile(r"^(build|test|run|screenshots|archive|export)$"),
    "scheme": re.compile(r"^[A-Za-z0-9][A-Za-z0-9 _.+-]{0,99}$"),
    "project": re.compile(r"^$|^(?![/-])(?!.*(^|/)\.\.(/|$))[A-Za-z0-9 _.+/-]{1,200}$"),
    "destination": re.compile(r"^$|^[A-Za-z0-9 _.,=:()+/-]{1,200}$"),
    "configuration": re.compile(r"^$|^[A-Za-z0-9_-]{1,40}$"),
    "workspace": re.compile(r"^[a-z0-9][a-z0-9-]{0,29}$"),
    "commit": re.compile(r"^[0-9a-f]{40}([0-9a-f]{24})?$"),
}
ID_RE = re.compile(r"^\d{8}T\d{6}Z-[0-9a-f]{6}$")
OPTIONAL_RULES = {
    "from": ID_RE,
    "method": re.compile(r"^(app-store-connect|release-testing|debugging|enterprise)$"),
    "upload": re.compile(r"^(yes|no)$"),
    "identity": re.compile(r"^[a-z0-9][a-z0-9-]{0,39}$"),
    "team": re.compile(r"^[A-Z0-9]{10}$"),
}
SEAL_KEY = Path("~/.aio-build/seal.pem").expanduser()

# Screenshot plans (run and screenshots jobs), checked the same way by
# the UI, aio-buildd and the worker, which builds simctl commands from them
PLAN_KEYS = ("shots", "devices", "appearances", "locales", "status_bar", "grant", "only_testing")
PLAN_NAME_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,39}$")
PLAN_ARG_RE = re.compile(r"^[A-Za-z0-9 _.,=:/+@%()-]{0,200}$")
PLAN_ENV_RE = re.compile(r"^[A-Z_][A-Z0-9_]{0,63}$")
PLAN_URL_RE = re.compile(r"^[A-Za-z][A-Za-z0-9+.-]{0,30}:[A-Za-z0-9._~:/?#@!&()*+,;=%-]{1,300}$")
PLAN_DEVICE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9 ()._-]{0,59}$")
PLAN_LOCALE_RE = re.compile(r"^[a-z]{2,3}([_-][A-Za-z0-9]{2,8}){0,2}$")
PLAN_TEST_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]{0,99}(/[A-Za-z_][A-Za-z0-9_]{0,99}){0,2}$")
MAX_SHOTS = 60          # screenshots per job
MAX_TEST_RUNS = 16      # device x locale x appearance runs of a screenshots job


def check_plan(spec: dict) -> str:
    """'' if the job's screenshot plan (if any) is acceptable, else why not."""
    action = spec.get("action")
    used = [k for k in PLAN_KEYS if k in spec]
    if used and action not in ("run", "screenshots"):
        return f"{', '.join(used)}: for run and screenshots jobs"

    def strs(k, rx, most):
        v = spec.get(k, [])
        return (isinstance(v, list) and len(v) <= most and len(set(v)) == len(v)
                and all(isinstance(x, str) and rx.match(x) for x in v))
    if not strs("devices", PLAN_DEVICE_RE, 4):
        return "devices: up to 4 Simulator device names, e.g. iPhone 16 Pro Max"
    if not strs("locales", PLAN_LOCALE_RE, 4):
        return "locales: up to 4, e.g. en_US, de_DE"
    if not strs("appearances", re.compile(r"^(light|dark)$"), 2):
        return "appearances: light and/or dark"
    if not strs("only_testing", PLAN_TEST_RE, 8):
        return "only_testing: up to 8 of Target, Target/Class or Target/Class/testMethod"
    if spec.get("only_testing") and action != "screenshots":
        return "only_testing: for screenshots jobs"
    if spec.get("status_bar", "clean") != "clean" or spec.get("grant", "all") != "all":
        return "status_bar: clean; grant: all"
    shots = spec.get("shots", [])
    if not isinstance(shots, list) or len(shots) > 12:
        return "shots: up to 12"
    if shots and action != "run":
        return "shots: for run jobs (a screenshots job's come from its UI tests)"
    names = set()
    for s in shots:
        if not isinstance(s, dict) or set(s) - {"name", "args", "env", "url", "wait"}:
            return "each shot: name, and optionally args, env, url, wait"
        if not isinstance(s.get("name"), str) or not PLAN_NAME_RE.match(s["name"]) or s["name"] in names:
            return "shot names: lowercase letters, digits and dashes, unique"
        names.add(s["name"])
        a = s.get("args", [])
        if not isinstance(a, list) or len(a) > 10 or not all(isinstance(x, str) and PLAN_ARG_RE.match(x) for x in a):
            return f"shot {s['name']}: args, up to 10 (letters, digits, spaces and _ . , = : / + @ % ( ) -)"
        e = s.get("env", {})
        if not isinstance(e, dict) or len(e) > 10 or not all(
                PLAN_ENV_RE.match(k) and isinstance(v, str) and PLAN_ARG_RE.match(v) for k, v in e.items()):
            return f"shot {s['name']}: env, up to 10 NAME: value"
        if "url" in s and not (isinstance(s["url"], str) and PLAN_URL_RE.match(s["url"])):
            return f"shot {s['name']}: url, a deep link such as myapp://notes/1"
        w = s.get("wait", 5)
        if not isinstance(w, int) or isinstance(w, bool) or not 0 <= w <= 60:
            return f"shot {s['name']}: wait, 0-60 seconds"
    runs = max(1, len(spec.get("devices", []))) * max(1, len(spec.get("locales", []))) \
        * max(1, len(spec.get("appearances", [])))
    if action == "run" and runs * max(1, len(shots)) > MAX_SHOTS:
        return f"at most {MAX_SHOTS} screenshots per job (devices x locales x appearances x shots)"
    if action == "screenshots" and runs > MAX_TEST_RUNS:
        return f"at most {MAX_TEST_RUNS} device x locale x appearance runs per job"
    return ""


def log(msg: str):
    print(time.strftime("%H:%M:%S"), msg, flush=True)


class Worker:
    def __init__(self, cfg: dict):
        self.cfg = cfg
        self.name = cfg["name"]
        self.user_host = cfg["host"]
        self.ssh_base = ["ssh", "-i", str(Path(cfg["key"]).expanduser()), "-o", "IdentitiesOnly=yes",
                         "-o", f"UserKnownHostsFile={Path(cfg['known_hosts']).expanduser()}",
                         "-o", "StrictHostKeyChecking=accept-new", "-o", "BatchMode=yes",
                         "-o", "ServerAliveInterval=30", "-p", str(cfg["port"]), *cfg["ssh_args"]]
        self.git_env = {**os.environ, "GIT_SSH_COMMAND": " ".join(shlex.quote(x) for x in self.ssh_base),
                        "GIT_TERMINAL_PROMPT": "0"}
        self.running: dict[tuple[str, str], threading.Event] = {}
        self.lock = threading.Lock()
        self.work = Path(cfg["work"]).expanduser()
        self.facts = {"host": socket.gethostname(), "version": VERSION, "image": cfg["image"],
                      "max_vms": cfg["max_vms"], "tart": self.out([cfg["tart"], "--version"]),
                      "macos": self.out(["sw_vers", "-productVersion"])}

    # ------------------------------------------------------------ plumbing
    @staticmethod
    def out(cmd: list[str]) -> str:
        try:
            return subprocess.run(cmd, capture_output=True, text=True, timeout=30).stdout.strip()[:100]
        except (OSError, subprocess.SubprocessError):
            return ""

    def ssh(self, *cmd: str, input: bytes | None = None, timeout: int = 60) -> bytes:
        p = subprocess.run(self.ssh_base + [self.user_host, " ".join(shlex.quote(c) for c in cmd)],
                           input=input, capture_output=True, timeout=timeout)
        if p.returncode != 0:
            raise RuntimeError(p.stderr.decode(errors="replace").strip() or f"ssh {cmd[0]} failed")
        return p.stdout

    def repo_url(self, ws: str) -> str:
        user, _, host = self.user_host.rpartition("@")
        host = f"[{host}]" if ":" in host else host
        return f"ssh://{user + '@' if user else ''}{host}:{self.cfg['port']}/{ws}.git"

    def tart(self, *args: str, timeout: int = 600, check: bool = True) -> subprocess.CompletedProcess:
        p = subprocess.run([self.cfg["tart"], *args], capture_output=True, text=True, timeout=timeout)
        if check and p.returncode != 0:
            raise RuntimeError(f"tart {args[0]}: {(p.stderr or p.stdout).strip()[:500]}")
        return p

    # ------------------------------------------------------------ the seal key
    def seal_key(self) -> dict:
        """This worker's RSA seal key (made once), its public half and an ssh
        signature over it with the worker's key: what the UI encrypts export
        keys to, after checking the signature against the key it added."""
        pub = SEAL_KEY.with_suffix(".pub.pem")
        if not SEAL_KEY.is_file():
            SEAL_KEY.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
            old = os.umask(0o077)
            try:
                subprocess.run(["openssl", "genrsa", "-out", str(SEAL_KEY), "4096"], check=True, capture_output=True)
            finally:
                os.umask(old)
            pub.unlink(missing_ok=True)
        sig = pub.with_name(pub.name + ".sig")
        if not pub.is_file() or not sig.is_file():
            subprocess.run(["openssl", "rsa", "-in", str(SEAL_KEY), "-pubout", "-out", str(pub)], check=True,
                           capture_output=True)
            sig.unlink(missing_ok=True)
            subprocess.run(["ssh-keygen", "-q", "-Y", "sign", "-n", "aio-seal", "-f",
                            str(Path(self.cfg["key"]).expanduser()), str(pub)], check=True, capture_output=True)
        return {"pem": pub.read_text(), "sig": sig.read_text()}

    def unseal(self, sealed: bytes, dest: Path):
        """The export's keys: RSA-OAEP unwraps the AES and HMAC keys, the HMAC
        is checked, then AES-256-CBC decrypts a tar of the files."""
        import base64
        import hashlib
        import hmac
        import io
        import tarfile
        box = json.loads(sealed)
        wrapped = base64.b64decode(box["workers"][self.name])
        p = subprocess.run(["openssl", "pkeyutl", "-decrypt", "-inkey", str(SEAL_KEY),
                            "-pkeyopt", "rsa_padding_mode:oaep"], input=wrapped, capture_output=True, timeout=60)
        if p.returncode != 0 or len(p.stdout) != 64:
            raise JobError("couldn't unwrap the sealed keys (sealed for another seal key?)")
        k_enc, k_mac = p.stdout[:32], p.stdout[32:]
        iv, ct = base64.b64decode(box["iv"]), base64.b64decode(box["ct"])
        if not hmac.compare_digest(hmac.new(k_mac, iv + ct, hashlib.sha256).digest(), base64.b64decode(box["mac"])):
            raise JobError("the sealed keys were tampered with (HMAC mismatch)")
        p = subprocess.run(["openssl", "enc", "-d", "-aes-256-cbc", "-K", k_enc.hex(), "-iv", iv.hex()],
                           input=ct, capture_output=True, timeout=60)
        if p.returncode != 0:
            raise JobError("couldn't decrypt the sealed keys")
        dest.mkdir(mode=0o700)
        with tarfile.open(fileobj=io.BytesIO(p.stdout)) as t:
            for m in t.getmembers():
                if not m.isfile() or not re.match(r"^(profiles/)?[A-Za-z0-9._-]{1,100}$", m.name):
                    raise JobError(f"unexpected file in the sealed keys: {m.name[:60]}")
                target = dest / m.name
                target.parent.mkdir(mode=0o700, exist_ok=True)
                fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
                with os.fdopen(fd, "wb") as f:
                    f.write(t.extractfile(m).read())

    # ------------------------------------------------------------ loop
    def heartbeat_loop(self):
        sealed_at = 0.0
        while True:
            if time.time() - sealed_at > 600:
                try:
                    self.ssh("seal-key", input=json.dumps(self.seal_key()).encode())
                    sealed_at = time.time()
                except (RuntimeError, OSError, subprocess.SubprocessError) as e:
                    log(f"couldn't register the seal key: {e}")
            try:
                with self.lock:
                    running = [list(k) for k in self.running]
                reply = json.loads(self.ssh("heartbeat", input=json.dumps({**self.facts, "running": running}).encode())
                                   or b"{}")
                for ws, jid in reply.get("cancel", []):
                    ev = self.running.get((ws, jid))
                    if ev and not ev.is_set():
                        log(f"{ws}/{jid}: cancel requested")
                        ev.set()
            except (RuntimeError, ValueError, OSError, subprocess.SubprocessError) as e:
                log(f"heartbeat failed: {e}")
            time.sleep(20)

    def clean_leftovers(self):
        """VMs from a run that crashed (named aio-…), not ours now."""
        try:
            vms = json.loads(self.tart("list", "--format", "json").stdout or "[]")
        except (RuntimeError, ValueError, OSError):
            return
        for vm in vms:
            name = vm.get("Name") or vm.get("name") or ""
            if name.startswith("aio-") and (vm.get("Source") or vm.get("source", "local")) == "local":
                log(f"removing leftover VM {name}")
                self.tart("stop", name, check=False, timeout=120)
                self.tart("delete", name, check=False, timeout=120)

    def run_forever(self, once: bool = False):
        self.work.mkdir(parents=True, exist_ok=True)
        self.clean_leftovers()
        threading.Thread(target=self.heartbeat_loop, daemon=True).start()
        log(f"worker {self.name}: {self.user_host}, image {self.cfg['image']}, up to {self.cfg['max_vms']} VM(s)")
        while True:
            with self.lock:
                free = len(self.running) < int(self.cfg["max_vms"])
            job = None
            if free:
                try:
                    job = json.loads(self.ssh("next") or b"{}")
                except (RuntimeError, ValueError, OSError, subprocess.SubprocessError) as e:
                    log(f"next failed: {e}")
            if job:
                ev = threading.Event()
                with self.lock:
                    self.running[(job["workspace"], job["id"])] = ev
                t = threading.Thread(target=self.run_job, args=(job, ev), daemon=True)
                t.start()
                if once:
                    t.join()
                    return
                continue
            if once and not self.running:
                log("no job queued")
                return
            time.sleep(float(self.cfg["poll_seconds"]))

    # ------------------------------------------------------------ one job
    def run_job(self, job: dict, cancel: threading.Event):
        ws, jid, spec = job["workspace"], job["id"], job.get("spec") or {}
        key = (ws, jid)
        started = time.time()
        summary = {"status": "error", "worker": self.name, "started": started, "action": spec.get("action"),
                   "scheme": spec.get("scheme"), "commit": job.get("commit"), "image": self.cfg["image"]}
        tail = collections.deque(maxlen=4000)
        workdir = Path(tempfile.mkdtemp(prefix=f"{ws}-{jid}-", dir=self.work))
        vm = f"aio-{ws}-{jid}".lower()
        progress = None
        vm_proc = None
        full_log = workdir / "build.log"
        logf = full_log.open("ab")

        def say(line: str):
            data = (line.rstrip("\n") + "\n").encode(errors="replace")
            logf.write(data)
            tail.append(line.rstrip("\n"))
            if progress and progress.poll() is None:
                try:
                    progress.stdin.write(data)
                    progress.stdin.flush()
                except OSError:
                    pass

        try:
            progress = subprocess.Popen(self.ssh_base + [self.user_host, f"progress {ws} {jid}"],
                                        stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            bad = check(job, spec)
            if bad:
                raise JobError(f"refusing the job: {bad}")
            say(f"== agent-sandboxes build {ws}/{jid} on {self.name} ({self.facts['host']})")
            say(f"== {spec['action']} {spec['scheme']} at {job['commit'][:12]}, image {self.cfg['image']}")
            src, out = workdir / "src", workdir / "out"
            out.mkdir()
            if spec["action"] == "export":
                # No checkout: the archive job's .xcarchive and the sealed keys
                say(f"== export of {spec['from']} ({spec['method']}{', upload' if spec.get('upload') == 'yes' else ''}),"
                    f" identity {spec.get('identity', '?')}")
                src.mkdir(mode=0o700)
                with (src / "build.xcarchive.zip").open("wb") as f:
                    p = subprocess.run(self.ssh_base + [self.user_host, f"source {ws} {jid}"], stdout=f,
                                       stderr=subprocess.PIPE, timeout=3600)
                if p.returncode != 0:
                    raise JobError(f"couldn't get the archive: {p.stderr.decode(errors='replace').strip()[:300]}")
                self.unseal(self.ssh("seal", ws, jid), src / "keys")
                say("== keys unsealed for this job")
                shares = [f"--dir=in:{src}:ro", f"--dir=out:{out}"]
            else:
                self.fetch(ws, jid, job["commit"], src)
                shares = [f"--dir=src:{src}:ro", f"--dir=out:{out}"]
            say("== starting the VM")
            self.tart("clone", self.cfg["image"], vm, timeout=1800)
            vm_proc = subprocess.Popen([self.cfg["tart"], "run", vm, *shares, *self.cfg["run_args"]],
                                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            self.wait_boot(vm, vm_proc, cancel)
            say("== VM up; running the job")
            limit = started + 60 * int(spec.get("timeout_min", 60))
            env = [f"{k}={v}" for k, v in (self.cfg.get("vm_env") or {}).items()]
            script = (export_script if spec["action"] == "export" else job_script)(spec, self.cfg["share_root"])
            cmd = [self.cfg["tart"], "exec", vm, "/usr/bin/env", *env, "/bin/bash", "-lc", script]
            p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
            reader = threading.Thread(target=lambda: [say(x.decode(errors="replace")) for x in p.stdout], daemon=True)
            reader.start()
            while p.poll() is None:
                if cancel.is_set():
                    p.kill()
                    summary["status"] = "cancelled"
                    break
                if time.time() > limit:
                    p.kill()
                    summary["status"] = "timeout"
                    break
                time.sleep(1)
            p.wait()
            reader.join(10)
            rc_file = out / "exit_code"
            rc = int(rc_file.read_text().strip()) if rc_file.exists() and rc_file.read_text().strip().isdigit() else p.returncode
            summary["exit_code"] = rc
            if summary["status"] == "error":
                summary["status"] = "passed" if rc == 0 else "failed"
            if spec["action"] == "export":
                summary.update({"from": spec["from"], "method": spec["method"], "identity": spec.get("identity", ""),
                                "uploaded": spec.get("upload") == "yes" and rc == 0})
            xv = next((x for x in tail if x.startswith("Xcode ")), "")
            summary["xcode"] = xv
            say(f"== {summary['status']} (exit {rc})")
            self.publish(ws, jid, out, summary, full_log, logf, say)
        except Exception as e:      # noqa: BLE001 - anything: report it as the job's result
            summary["error"] = str(e)[:2000]
            say(f"== error: {e}")
            try:
                self.publish(ws, jid, workdir / "out", summary, full_log, logf, say)
            except Exception as e2:  # noqa: BLE001
                log(f"{ws}/{jid}: couldn't push the result: {e2}")
        finally:
            if vm_proc:
                self.tart("stop", vm, check=False, timeout=120)
                vm_proc.wait(60) if vm_proc.poll() is None else None
            self.tart("delete", vm, check=False, timeout=120)
            if progress:
                try:
                    progress.stdin.close()
                    progress.wait(30)
                except (OSError, subprocess.SubprocessError):
                    progress.kill()
            logf.close()
            shutil.rmtree(workdir, ignore_errors=True)
            with self.lock:
                self.running.pop(key, None)
            log(f"{ws}/{jid}: {summary['status']}")

    def fetch(self, ws: str, jid: str, commit: str, src: Path):
        src.mkdir()
        g = ["git", "-C", str(src), "-c", "core.hooksPath=/dev/null"]
        subprocess.run([*g, "init", "-q"], check=True)
        p = subprocess.run([*g, "fetch", "-q", "--no-tags", self.repo_url(ws), f"refs/tags/build/{jid}"],
                           env=self.git_env, capture_output=True, text=True, timeout=1800)
        if p.returncode != 0:
            raise JobError(f"git fetch: {p.stderr.strip()[:500]}")
        subprocess.run([*g, "-c", "advice.detachedHead=false", "checkout", "-q", "--detach", f"{commit}"],
                       check=True, timeout=600)
        subprocess.run([*g, "submodule", "update", "--init", "--recursive", "-q"], env=self.git_env,
                       capture_output=True, timeout=1800)     # best effort: may need hosts the VM can't reach

    def wait_boot(self, vm: str, proc: subprocess.Popen, cancel: threading.Event):
        deadline = time.time() + int(self.cfg["boot_timeout"])
        while time.time() < deadline:
            if proc.poll() is not None:
                raise JobError(f"tart run exited ({proc.returncode})")
            if cancel.is_set():
                raise JobError("cancelled while starting")
            if self.tart("exec", vm, "/usr/bin/true", check=False, timeout=30).returncode == 0:
                return
            time.sleep(3)
        raise JobError("the VM didn't come up (is the Tart guest agent in the image?)")

    def publish(self, ws, jid, out: Path, summary: dict, full_log: Path, logf, say):
        summary["finished"] = time.time()
        summary["seconds"] = round(summary["finished"] - summary["started"])
        logf.flush()
        out_fd = open_dir(out)
        try:
            names = os.listdir(out_fd) if out_fd is not None else []
            for name in sorted(n for n in names if re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,99}\.(zip|ipa|pkg)", n)):
                data = read_out(out_fd, name, 4 << 30)
                if data is None:
                    continue
                try:
                    self.ssh("artifact", ws, jid, name, input=data, timeout=3600)
                    summary.setdefault("artifacts", []).append(name)
                    say(f"== uploaded {name}")
                except (RuntimeError, OSError, subprocess.SubprocessError) as e:
                    say(f"== couldn't upload {name}: {e}")
            res = Path(tempfile.mkdtemp(prefix="result-", dir=self.work))
            try:
                data = full_log.read_bytes()
                (res / "build.log").write_bytes(data[-MAX_RESULT_LOG:])
                if out_fd is not None:
                    if (ts := read_out(out_fd, "test-summary.json", 5 << 20)) is not None:
                        (res / "test-summary.json").write_bytes(ts)
                    if n := copy_screenshots(out_fd, res / "screenshots"):
                        say(f"== {n} screenshot(s)")
                self.push_result(ws, jid, res, summary)
            finally:
                shutil.rmtree(res, ignore_errors=True)
        finally:
            if out_fd is not None:
                os.close(out_fd)

    def push_result(self, ws, jid, res: Path, summary: dict):
        (res / "summary.json").write_text(json.dumps(summary, indent=2) + "\n")
        g = ["git", "-C", str(res), "-c", "core.hooksPath=/dev/null", "-c", f"user.name=aio-worker-{self.name}",
             "-c", "user.email=worker@agent-sandboxes.invalid"]
        subprocess.run([*g, "init", "-q"], check=True)
        subprocess.run([*g, "add", "-A"], check=True)
        subprocess.run([*g, "commit", "-q", "-m", f"result of build/{jid}: {summary['status']}"], check=True)
        p = subprocess.run([*g, "push", "-q", self.repo_url(ws), f"HEAD:refs/results/{jid}"],
                           env=self.git_env, capture_output=True, text=True, timeout=600)
        if p.returncode != 0:
            raise RuntimeError(p.stderr.strip()[:500])


# ---------------------------------------------------------------- the VM's outputs
# The out folder is shared read-write into the VM: whatever's there, the job's
# code may have put there, symlinks included. Opened step by step with
# O_NOFOLLOW, read with a size limit.
MAX_SHOT_BYTES = 25 << 20
MAX_SHOTS_BYTES = 400 << 20
SHOT_FILE_RE = re.compile(r"^[a-z0-9][a-z0-9._-]{0,150}\.png$")


def open_dir(path, dir_fd=None):
    try:
        return os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=dir_fd)
    except OSError:
        return None


def read_out(dir_fd: int, name: str, limit: int):
    """A regular file's bytes, or None (missing, a symlink, not a file, too big)."""
    import stat
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=dir_fd)
    except OSError:
        return None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_size > limit:
            return None
        with os.fdopen(fd, "rb", closefd=False) as f:
            data = f.read(limit + 1)
        return data if len(data) <= limit else None
    finally:
        os.close(fd)


def copy_screenshots(out_fd: int, dest: Path) -> int:
    """screenshots/*.png (up to MAX_SHOTS), their thumbs/ and index.jsonl ->
    dest/, with index.json listing what each one is."""
    sfd = open_dir("screenshots", out_fd)
    if sfd is None:
        return 0
    try:
        files = sorted(n for n in os.listdir(sfd) if SHOT_FILE_RE.match(n))[:MAX_SHOTS]
        kept, total = [], 0
        for n in files:
            data = read_out(sfd, n, MAX_SHOT_BYTES)
            if data is None or not data.startswith(b"\x89PNG") or total + len(data) > MAX_SHOTS_BYTES:
                continue
            total += len(data)
            dest.mkdir(exist_ok=True)
            (dest / n).write_bytes(data)
            kept.append(n)
        tfd = open_dir("thumbs", sfd)
        if tfd is not None:
            try:
                for n in kept:
                    data = read_out(tfd, n, 2 << 20)
                    if data is not None and data.startswith(b"\x89PNG"):
                        (dest / "thumbs").mkdir(exist_ok=True)
                        (dest / "thumbs" / n).write_bytes(data)
            finally:
                os.close(tfd)
        index = []
        raw = read_out(sfd, "index.jsonl", 1 << 20) or b""
        for line in raw.decode(errors="replace").splitlines():
            try:
                e = json.loads(line)
            except ValueError:
                continue
            if isinstance(e, dict) and e.get("file") in kept:
                index.append({k: str(v)[:200] for k, v in e.items()
                              if k in ("file", "shot", "device", "locale", "appearance", "test")})
        if kept:
            listed = {e["file"] for e in index}
            index += [{"file": n} for n in kept if n not in listed]
            (dest / "index.json").write_text(json.dumps(index, indent=1) + "\n")
        return len(kept)
    finally:
        os.close(sfd)


class JobError(Exception):
    pass


def check(job: dict, spec: dict) -> str:
    if not ID_RE.match(job.get("id", "")):
        return "bad job id"
    for k, rx in SPEC_RULES.items():
        if not isinstance(spec.get(k, ""), str) or not rx.match(spec.get(k, "")):
            return f"bad {k}"
    for k, rx in OPTIONAL_RULES.items():
        if k in spec and (not isinstance(spec[k], str) or not rx.match(spec[k])):
            return f"bad {k}"
    if spec["action"] == "export" and not (spec.get("from") and spec.get("method")):
        return "an export needs from and method"
    if why := check_plan(spec):
        return why
    if spec["workspace"] != job.get("workspace") or spec["commit"] != job.get("commit"):
        return "the spec doesn't match the job"
    return ""


def job_script(spec: dict, share_root: str) -> str:
    """The fixed steps, run in the VM by bash. Every value from the job was
    checked against SPEC_RULES and is quoted here as well."""
    q = shlex.quote
    project, action = spec.get("project", ""), spec["action"]
    xb = ["xcodebuild", "-scheme", spec["scheme"], "-derivedDataPath", "$HOME/aio-dd"]
    cd = "."
    if project.endswith(".xcodeproj"):
        xb[1:1] = ["-project", project]
    elif project.endswith(".xcworkspace"):
        xb[1:1] = ["-workspace", project]
    elif project:
        cd = project                    # a Swift package's folder
    if spec.get("configuration"):
        xb += ["-configuration", spec["configuration"]]
    if spec.get("destination"):
        xb += ["-destination", spec["destination"]]
    args = " ".join("\"$HOME/aio-dd\"" if a == "$HOME/aio-dd" else q(a) for a in xb)
    if action == "build" or action == "run":
        run = f"{args} build"
    elif action == "test":
        run = f"{args} test -resultBundlePath \"$OUT/result.xcresult\""
    elif action == "screenshots":
        run = f"{args} build-for-testing"
    else:
        # Ad-hoc signed ("-"), so the binary carries the project's entitlements
        # for export_build / sign_ipa to re-sign with; unsigned if that fails
        team = f" DEVELOPMENT_TEAM={q(spec['team'])}" if spec.get("team") else ""
        run = (f"{args} archive -archivePath \"$OUT/build.xcarchive\" CODE_SIGN_IDENTITY=- CODE_SIGN_STYLE=Manual "
               f"CODE_SIGNING_REQUIRED=NO CODE_SIGNING_ALLOWED=YES PROVISIONING_PROFILE_SPECIFIER={team}")
        unsigned = (f"{args} archive -archivePath \"$OUT/build.xcarchive\" CODE_SIGNING_ALLOWED=NO "
                    "CODE_SIGNING_REQUIRED=NO CODE_SIGN_IDENTITY=\"\"")
    lines = [
        "set -uo pipefail",
        f"SHARE={q(share_root)}",
        "OUT=\"$HOME/aio-out\"; rm -rf \"$OUT\" \"$HOME/aio-src\"; mkdir -p \"$OUT/screenshots\"",
        "finish() { rc=$?; [ -f \"$OUT/exit_code\" ] || echo $rc > \"$OUT/exit_code\";",
        "  cp \"$OUT/exit_code\" \"$SHARE/out/\" 2>/dev/null; cp \"$OUT\"/test-summary.json \"$SHARE/out/\" 2>/dev/null;",
        "  cp -R \"$OUT/screenshots\" \"$SHARE/out/\" 2>/dev/null;",
        "  cp \"$OUT\"/*.zip \"$SHARE/out/\" 2>/dev/null; true; }",
        "trap finish EXIT",
        "ditto \"$SHARE/src\" \"$HOME/aio-src\" || exit 70",
        f"cd \"$HOME/aio-src\"/{q(cd)} || exit 71",
        "xcodebuild -version",
        f"echo '$ ' {q(run)}",
        f"{run} 2>&1 | tee \"$OUT/first.log\"; rc=${{PIPESTATUS[0]}}" if action == "archive" else f"{run}; rc=$?",
    ]
    if action == "archive":
        lines += [
            "if [ $rc != 0 ] && grep -qiE 'sign|provision' \"$OUT/first.log\"; then",
            "  echo '== ad-hoc signing failed; archiving unsigned (no entitlements in the binary: signing uses the "
            "profile'\\''s)'",
            f"  rm -rf \"$OUT/build.xcarchive\"; {unsigned}; rc=$?",
            "fi",
        ]
    if action == "test":
        lines += ["xcrun xcresulttool get test-results summary --path \"$OUT/result.xcresult\" --compact "
                  "> \"$OUT/test-summary.json\" 2>/dev/null || rm -f \"$OUT/test-summary.json\""]
    if action == "archive":
        lines += ["[ $rc = 0 ] && (cd \"$OUT\" && ditto -c -k --keepParent build.xcarchive build.xcarchive.zip)"]
    if action in ("run", "screenshots"):
        lines += SIM_FUNCS.splitlines()
        lines += (run_shots if action == "run" else ui_test_shots)(spec, xb)
        lines += ["make_thumbs"]
    lines += ["echo $rc > \"$OUT/exit_code\"", "exit $rc"]
    return "\n".join(lines) + "\n"


# Shell functions for run and screenshots jobs, in the VM
SIM_FUNCS = r"""
sim_udid() {  # the newest available Simulator called $1; made if there's none
  local u
  u=$(xcrun simctl list devices available -j | /usr/bin/python3 -c '
import json, re, sys
d = json.load(sys.stdin)["devices"]
for rt in sorted(d, key=lambda r: [int(x) for x in re.findall(r"[0-9]+", r)], reverse=True):
    for x in d[rt]:
        if x["name"] == sys.argv[1]:
            print(x["udid"]); sys.exit()
' "$1")
  [ -n "$u" ] || u=$(xcrun simctl create "$1" "$1" 2>/dev/null)
  echo "$u"
}
sim_up() { xcrun simctl boot "$1" 2>/dev/null; xcrun simctl bootstatus "$1" -b >/dev/null; }
clean_bar() {
  xcrun simctl status_bar "$1" override --time 9:41 --dataNetwork wifi --wifiMode active --wifiBars 3 \
    --cellularMode active --cellularBars 4 --batteryState charged --batteryLevel 100 >/dev/null 2>&1 || true
}
find_app() {  # the app (not a UI test runner) xcodebuild built
  APP=$(find "$HOME/aio-dd/Build/Products" -maxdepth 2 -name '*.app' -type d ! -name '*-Runner.app' | head -1)
  BID=""
  [ -n "$APP" ] && BID=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$APP/Info.plist")
}
make_thumbs() {
  ls "$OUT"/screenshots/*.png >/dev/null 2>&1 || return 0
  mkdir -p "$OUT/screenshots/thumbs"
  for f in "$OUT"/screenshots/*.png; do
    sips -Z 480 "$f" --out "$OUT/screenshots/thumbs/$(basename "$f")" >/dev/null 2>&1
  done
  true
}
"""

# A screenshots job's UI test attachments (xcresulttool export attachments,
# Xcode 16+) -> screenshots/<prefix>-<name>.png, listed in index.jsonl
EXPORT_SHOTS = r"""
import json, os, re, shutil, subprocess, sys
src, dst, prefix, meta = sys.argv[1], sys.argv[2], sys.argv[3], json.loads(sys.argv[4])
try:
    manifest = json.load(open(os.path.join(src, "manifest.json")))
except Exception:
    manifest = []
seen = set(os.listdir(dst))
for test in manifest if isinstance(manifest, list) else []:
    for a in test.get("attachments", []):
        f = str(a.get("exportedFileName", ""))
        if "/" in f or not re.search(r"[.](png|jpe?g|heic)$", f, re.I):
            continue
        name = str(a.get("suggestedHumanReadableName") or f)
        name = re.sub(r"[.][A-Za-z]+$", "", name)
        name = re.sub(r"_[0-9]+_[0-9A-Fa-f-]{36}$", "", name)
        name = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")[:40] or "shot"
        out, i = f"{prefix}-{name}.png", 2
        while out in seen:
            out, i = f"{prefix}-{name}-{i}.png", i + 1
        seen.add(out)
        if f.lower().endswith(".png"):
            shutil.copy(os.path.join(src, f), os.path.join(dst, out))
        else:
            subprocess.run(["sips", "-s", "format", "png", os.path.join(src, f), "--out", os.path.join(dst, out)],
                           capture_output=True)
        if os.path.isfile(os.path.join(dst, out)):
            with open(os.path.join(dst, "index.jsonl"), "a") as fh:
                fh.write(json.dumps({**meta, "shot": name, "file": out,
                                     "test": str(test.get("testIdentifier", ""))}) + "\n")
"""


def plan_matrix(spec: dict):
    """(devices, locales, appearances): '' meaning the Simulator's default."""
    m = re.search(r"(?:^|,)name=([^,]+)", spec.get("destination", ""))
    devices = spec.get("devices") or ([m[1]] if m else [])
    return devices, spec.get("locales") or [""], spec.get("appearances") or [""]


def shot_prefix(device: str, locale: str, appearance: str) -> str:
    slug = re.sub(r"[^a-z0-9]+", "-", device.lower()).strip("-")[:40] or "device"
    return "-".join([slug] + ([locale.lower().replace("_", "-")] if locale else []) + ([appearance] if appearance else []))


def device_block(device: str, spec: dict, body: list[str]) -> list[str]:
    """Boot (or make) the Simulator, with the job's settings, then body."""
    q = shlex.quote
    return [
        f"echo {q('== Simulator ' + device)}",
        f"U=$(sim_udid {q(device)})",
        f"if [ -z \"$U\" ]; then echo {q('== no Simulator called ' + device + ', and none could be made')}; rc=74; else",
        "  sim_up \"$U\"",
        *(["  clean_bar \"$U\""] if spec.get("status_bar") == "clean" else []),
        *("  " + x for x in body),
        "  xcrun simctl shutdown \"$U\" 2>/dev/null",
        "fi",
    ]


def appearance_line(appearance: str) -> list[str]:
    return [f"xcrun simctl ui \"$U\" appearance {appearance} || true"] if appearance else []


def run_shots(spec: dict, xb: list[str]) -> list[str]:
    """run: install the app on each device; per appearance, locale and shot,
    relaunch it (args, env, locale), open the deep link, wait, screenshot."""
    q = shlex.quote
    devices, locales, appearances = plan_matrix(spec)
    shots = spec.get("shots") or [{"name": "launch", "wait": 8}]
    if not devices:
        return ["echo '== run: no Simulator named (name= in the destination, or devices)'; rc=75"]
    out = ["if [ $rc = 0 ]; then", "  find_app",
           "  if [ -z \"$APP\" ]; then echo 'no .app was built'; rc=72; else"]
    for device in devices:
        body = ["xcrun simctl install \"$U\" \"$APP\" || rc=73"]
        if spec.get("grant") == "all":
            body.append("xcrun simctl privacy \"$U\" grant all \"$BID\" 2>/dev/null")
        for appearance in appearances:
            body += appearance_line(appearance)
            for locale in locales:
                loc = ["-AppleLanguages", f"({locale.replace('_', '-')})", "-AppleLocale", locale.replace("-", "_")] \
                    if locale else []
                for shot in shots:
                    name = f"{shot_prefix(device, locale, appearance)}-{shot['name']}.png"
                    meta = json.dumps({"file": name, "shot": shot["name"], "device": device, "locale": locale,
                                       "appearance": appearance})
                    env = [q(f"SIMCTL_CHILD_{k}={v}") for k, v in (shot.get("env") or {}).items()]
                    args = " ".join(q(a) for a in [*(shot.get("args") or []), *loc])
                    body += [
                        "xcrun simctl terminate \"$U\" \"$BID\" >/dev/null 2>&1",
                        f"echo {q('== shot ' + name)}",
                        f"env {' '.join(env)} xcrun simctl launch \"$U\" \"$BID\" {args} >/dev/null || rc=73",
                    ]
                    if shot.get("url"):
                        body += [f"sleep 2; xcrun simctl openurl \"$U\" {q(shot['url'])} || "
                                 f"echo {q('== could not open ' + shot['url'])}"]
                    body += [f"sleep {int(shot.get('wait', 5))}",
                             f"xcrun simctl io \"$U\" screenshot \"$OUT/screenshots/{name}\" >/dev/null 2>&1 && "
                             f"echo {q(meta)} >> \"$OUT/screenshots/index.jsonl\""]
        out += ["    " + x for x in device_block(device, spec, body)]
    out += ["  fi", "fi"]
    return out


def ui_test_shots(spec: dict, xb: list[str]) -> list[str]:
    """screenshots: the built UI tests on each device x locale x appearance;
    the screenshots they attach (XCTAttachment) become the job's."""
    q = shlex.quote
    devices, locales, appearances = plan_matrix(spec)
    if not devices:
        return ["echo '== screenshots: no Simulator named (name= in the destination, or devices)'; rc=75"]
    m = re.search(r"(?:^|,)platform=([^,]+)", spec.get("destination", ""))
    platform = m[1] if m else "iOS Simulator"
    base = xb[1:]                       # without "xcodebuild"
    if "-destination" in base:
        i = base.index("-destination")
        del base[i:i + 2]
    test_args = " ".join("\"$HOME/aio-dd\"" if a == "$HOME/aio-dd" else q(a) for a in base)
    only = " ".join(q(f"-only-testing:{t}") for t in spec.get("only_testing") or [])
    out = ["if [ $rc = 0 ]; then", "  find_app", "  trc=0; n=0"]
    for device in devices:
        # granted for the installed app; the tests' reinstall keeps it
        body = ["[ -n \"$BID\" ] && xcrun simctl install \"$U\" \"$APP\" && "
                "xcrun simctl privacy \"$U\" grant all \"$BID\" 2>/dev/null"] if spec.get("grant") == "all" else []
        for appearance in appearances:
            body += appearance_line(appearance)
            for locale in locales:
                lang, _, region = locale.replace("-", "_").partition("_")
                loc = f"-testLanguage {q(lang)}" + (f" -testRegion {q(region)}" if region else "") if locale else ""
                prefix = shot_prefix(device, locale, appearance)
                meta = json.dumps({"device": device, "locale": locale, "appearance": appearance})
                body += [
                    "n=$((n+1))",
                    f"echo {q('== UI tests: ' + prefix)}",
                    f"xcodebuild test-without-building {test_args} -destination \"platform={platform},id=$U\" "
                    f"{only} {loc} -resultBundlePath \"$OUT/tests-$n.xcresult\"; t=$?; [ $t = 0 ] || trc=$t",
                    "xcrun xcresulttool export attachments --path \"$OUT/tests-$n.xcresult\" --output-path "
                    "\"$OUT/att-$n\" >/dev/null 2>&1 || echo '== could not export the screenshots "
                    "(xcresulttool export attachments: Xcode 16 or later)'",
                    f"/usr/bin/python3 -c {q(EXPORT_SHOTS)} \"$OUT/att-$n\" \"$OUT/screenshots\" {q(prefix)} {q(meta)}",
                ]
        out += ["  " + x for x in device_block(device, spec, body)]
    out += ["  rc=$trc",
            "  ls \"$OUT\"/screenshots/*.png >/dev/null 2>&1 || echo '== no screenshots: the UI tests attach "
            "them with XCTAttachment(screenshot: XCUIApplication().screenshot()), lifetime .keepAlways'",
            "fi"]
    return out


def export_script(spec: dict, share_root: str) -> str:
    """An export, in the VM: the archive and the unsealed keys are in the
    read-only share in/. A keychain of its own holds the certificate for
    codesign; xcodebuild -exportArchive signs (and with keys/asc.p8 and an
    upload destination in ExportOptions.plist, uploads). No project code runs."""
    q = shlex.quote
    lines = [
        "set -uo pipefail",
        f"SHARE={q(share_root)}",
        "IN=\"$SHARE/in\"; K=\"$IN/keys\"; OUT=\"$HOME/aio-out\"; W=\"$HOME/aio-export\"",
        "KC=\"$HOME/Library/Keychains/aio-export.keychain-db\"",
        "PROFILES=(\"$HOME/Library/MobileDevice/Provisioning Profiles\" "
        "\"$HOME/Library/Developer/Xcode/UserData/Provisioning Profiles\")",
        "rm -rf \"$OUT\" \"$W\"; mkdir -p \"$OUT\" \"$W\"",
        "finish() { rc=$?; [ -f \"$OUT/exit_code\" ] || echo $rc > \"$OUT/exit_code\";",
        "  cp \"$OUT/exit_code\" \"$SHARE/out/\" 2>/dev/null; cp \"$OUT\"/export/*.ipa \"$OUT\"/export/*.pkg \"$SHARE/out/\" 2>/dev/null;",
        "  security delete-keychain \"$KC\" 2>/dev/null; rm -f \"${PROFILES[0]}\"/aio-* \"${PROFILES[1]}\"/aio-*; true; }",
        "trap finish EXIT",
        "cd \"$W\" && ditto -x -k \"$IN/build.xcarchive.zip\" . || exit 70",
        "[ -d \"$W/build.xcarchive\" ] || { echo 'no build.xcarchive in the archive job'\\''s zip'; exit 70; }",
        "KCPW=$(uuidgen)",
        "security create-keychain -p \"$KCPW\" \"$KC\" && security set-keychain-settings -lut 3600 \"$KC\" "
        "&& security unlock-keychain -p \"$KCPW\" \"$KC\" || exit 74",
        "security import \"$K/cert.p12\" -k \"$KC\" -f pkcs12 -P \"$(cat \"$K/password\")\" -T /usr/bin/codesign "
        "-T /usr/bin/security -T /usr/bin/productbuild >/dev/null || { echo \"couldn't import the certificate\"; exit 75; }",
        "security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k \"$KCPW\" \"$KC\" >/dev/null || exit 76",
        "security list-keychains -d user -s \"$KC\" $(security list-keychains -d user | tr -d '\"')",
        "for d in \"${PROFILES[@]}\"; do mkdir -p \"$d\"; for p in \"$K\"/profiles/*.mobileprovision; do "
        "cp \"$p\" \"$d/aio-$(basename \"$p\")\"; done; done",
        "AUTH=()",
        "if [ -f \"$K/asc.p8\" ]; then AUTH=(-authenticationKeyPath \"$K/asc.p8\" -authenticationKeyID "
        "\"$(cat \"$K/asc_key_id\")\" -authenticationKeyIssuerID \"$(cat \"$K/asc_issuer_id\")\"); fi",
        "xcodebuild -version",
        "echo '$ xcodebuild -exportArchive' \"($(/usr/libexec/PlistBuddy -c 'Print :method' \"$K/ExportOptions.plist\"),"
        " $(/usr/libexec/PlistBuddy -c 'Print :destination' \"$K/ExportOptions.plist\"))\"",
        "xcodebuild -exportArchive -archivePath \"$W/build.xcarchive\" -exportPath \"$OUT/export\" "
        "-exportOptionsPlist \"$K/ExportOptions.plist\" ${AUTH[@]+\"${AUTH[@]}\"}",
        "rc=$?",
        "ls -l \"$OUT/export\" 2>/dev/null",
        "echo $rc > \"$OUT/exit_code\"",
        "exit $rc",
    ]
    return "\n".join(lines) + "\n"


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--config", default=str(CONFIG))
    ap.add_argument("--once", action="store_true", help="take at most one job, then exit")
    a = ap.parse_args()
    cfg = dict(DEFAULTS)
    try:
        cfg.update(json.loads(Path(a.config).expanduser().read_text()))
    except (OSError, ValueError) as e:
        sys.exit(f"aio-build-worker: can't read {a.config}: {e}")
    if not cfg["name"] or not cfg["host"]:
        sys.exit("aio-build-worker: set name and host in the config")
    Worker(cfg).run_forever(once=a.once)


if __name__ == "__main__":
    main()
