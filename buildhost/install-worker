#!/usr/bin/env bash
# Set up this Mac as an agent-sandboxes build worker (run it on the Mac, as
# the user whose Tart VMs it should use; Apple silicon, macOS 13+):
#
#   buildhost/install-worker --host aiogit@sandbox.example.com [--port 22] \
#       [--name mac-mini] [--image ghcr.io/cirruslabs/macos-sequoia-xcode:latest] [--max-vms 1]
#
# Installs into ~/.aio-build: the worker, its ssh key, config.json, and a
# LaunchAgent that keeps it running while you're logged in. Prints the key
# to add under Build workers → Apple builds in the web UI. Needs Tart
# (https://tart.run; 2.x with `tart exec`) and an image with Xcode and the
# Tart guest agent (Cirrus Labs' *-xcode images have both).
set -euo pipefail

HOST=""; PORT=22; NAME=$(scutil --get LocalHostName 2>/dev/null | tr 'A-Z' 'a-z' | tr -c 'a-z0-9-\n' '-' || hostname -s)
IMAGE=ghcr.io/cirruslabs/macos-sequoia-xcode:latest; MAXVMS=1
while (($#)); do
  case $1 in
    --host) HOST=$2; shift 2 ;;
    --port) PORT=$2; shift 2 ;;
    --name) NAME=$2; shift 2 ;;
    --image) IMAGE=$2; shift 2 ;;
    --max-vms) MAXVMS=$2; shift 2 ;;
    -h|--help) sed -n '2,13p' "$0"; exit 0 ;;
    *) echo "unknown option $1" >&2; exit 2 ;;
  esac
done
[[ -n $HOST ]] || { echo "--host user@buildhost is required" >&2; exit 2; }
[[ $NAME =~ ^[a-z0-9][a-z0-9-]{0,29}$ ]] || { echo "--name: lowercase letters, digits and - ($NAME)" >&2; exit 2; }
[[ $(uname -s) == Darwin ]] || { echo "this is for the Mac" >&2; exit 1; }
TART=$(command -v tart || true)
[[ -n $TART ]] || { echo "Tart isn't installed: see https://tart.run" >&2; exit 1; }
PY=$(command -v python3 || true)
[[ -n $PY ]] && "$PY" -c 'import sys; sys.exit(sys.version_info < (3, 9))' 2>/dev/null || {
  echo "needs Python 3.9+ (xcode-select --install gives one)" >&2; exit 1; }

D="$HOME/.aio-build"
mkdir -p "$D/work"; chmod 700 "$D"
install -m 755 "$(cd "$(dirname "$0")" && pwd)/aio-build-worker" "$D/aio-build-worker"
[[ -f $D/worker_ed25519 ]] || ssh-keygen -q -t ed25519 -N "" -C "aio-worker-$NAME" -f "$D/worker_ed25519"
if [[ ! -f $D/config.json ]]; then
  cat > "$D/config.json" <<EOF
{
  "name": "$NAME",
  "host": "$HOST",
  "port": $PORT,
  "image": "$IMAGE",
  "max_vms": $MAXVMS,
  "tart": "$TART",
  "run_args": ["--no-graphics"],
  "vm_env": {}
}
EOF
  chmod 600 "$D/config.json"
else
  echo "Keeping your $D/config.json"
fi

PLIST="$HOME/Library/LaunchAgents/dev.agent-sandboxes.build-worker.plist"
mkdir -p "$(dirname "$PLIST")"
cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>dev.agent-sandboxes.build-worker</string>
  <key>ProgramArguments</key><array><string>$PY</string><string>$D/aio-build-worker</string></array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>$(dirname "$TART"):/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>$D/worker.log</string>
  <key>StandardErrorPath</key><string>$D/worker.log</string>
</dict></plist>
EOF
launchctl bootout "gui/$(id -u)" "$PLIST" 2>/dev/null || true
launchctl bootstrap "gui/$(id -u)" "$PLIST"

echo
echo "Installed. In the web UI, Build workers → Apple builds → Mac workers, add:"
echo "  name: $NAME"
echo "  key:  $(cat "$D/worker_ed25519.pub")"
echo
echo "Then pull the image once, so the first build doesn't wait for it:  tart pull $IMAGE"
echo "Its log: $D/worker.log   Settings: $D/config.json (then: launchctl kickstart -k gui/$(id -u)/dev.agent-sandboxes.build-worker)"
