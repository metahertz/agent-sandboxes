#!/usr/bin/env bash
# Start Claude Code for one workspace inside nono, with that workspace's
# policy: its own sandbox port only, its SSH agent, its tokens, its network
# allowlist and resource limits (all set in the web UI).
#
#   claude-in <workspace> [claude args...]
#   claude-in --shell <workspace>            a login shell under the same sandbox
#   claude-in --exec <workspace> <command>   one command (sh -c), e.g. rsync / sftp-server
#                                            for bin/ws-ssh; stdout stays clean
set -euo pipefail

mode=claude
case "${1:-}" in
  --shell) mode=shell; shift ;;
  --exec)  mode=exec; shift ;;
esac

ROOT="${AIO_ROOT:-$HOME/agent-sandboxes}"
WS_ROOT="${AIO_WORKSPACES:-$ROOT/workspaces}"
name="${1:?usage: claude-in [--shell | --exec] <workspace> [claude args... | command]}"; shift
env_file="$WS_ROOT/$name.env"
[[ -r "$env_file" ]] || { echo "No workspace '$name' ($env_file)." >&2; exit 1; }

set -a; source "$env_file"; set +a

if [[ "${WS_KIND:-}" == microvm ]]; then
  # Claude runs in the workspace's VM (bin/microvm), not under nono here:
  # in /project (the shared folder), over vsock ssh, with the agent forwarded.
  aux=(); [[ $mode == claude ]] || aux=(--aux)
  eval "$(python3 -I "$ROOT/ui/server.py" prepare "$name" "${aux[@]}")"    # agent keys, WS_PROMPT
  if [[ $("$ROOT/bin/microvm" status "$name") != active ]]; then
    echo "The VM for '$name' isn't running — start it from the web UI (or bin/microvm start $name)." >&2
    exit 1
  fi
  case $mode in
    claude) remote="cd /project && exec aio-claude${WS_PROMPT:+ --append-system-prompt $(printf '%q' "$WS_PROMPT")}$(printf ' %q' "$@")"
            tty=(-t) ;;
    shell)  remote="cd /project && exec bash -l"; tty=(-t) ;;
    exec)   remote="cd /project && ${1:?--exec needs a command}"; tty=() ;;
  esac
  exec "$ROOT/bin/microvm" ssh "$name" "${tty[@]}" -- "$remote"
fi

[[ $mode == exec ]] || if ! curl -fsS -o /dev/null --max-time 2 -H "X-AIO-API-Key: $WS_KEY" "http://127.0.0.1:${WS_PORT}/v1/docs"; then
  echo "AIO sandbox for '$name' isn't answering on :${WS_PORT} — start it from the web UI." >&2
fi

# Loads the agent's SSH keys and writes workspaces/<name>.profile.json
# (.aux-profile.json for --shell / --exec);
# sets WS_PROFILE, WS_MEMORY, WS_PIDS, and WS_PROMPT (how to use its API tokens).
aux=(); [[ $mode == claude ]] || aux=(--aux)   # don't overwrite what Claude started with
eval "$(python3 -I "$ROOT/ui/server.py" prepare "$name" "${aux[@]}")"

# AIO_NONO: another nono build (e.g. one from source, for testing);
# AIO_NONO_LIVE_AUDIT=1 when it writes proxy events to its audit trail as they
# happen (nono after 0.81, #2235).
cmd=("${AIO_NONO:-nono}" run --profile "$WS_PROFILE" --allow-cwd)
if [[ $mode == exec ]]; then
  cmd+=(--silent)
else
  # nono's log goes to a file outside the sandbox, which the metrics exporter
  # ships to Loki, and its warnings stay out of Claude's terminal. nono up to
  # 0.81 keeps only 4096 proxy events for the audit trail, written at exit,
  # so it also logs each one; the marker tells the exporter this session's
  # proxy events come from the log.
  logs="$ROOT/monitoring/data/nono-logs"
  mkdir -p -m 700 "$logs"
  if [[ "${AIO_NONO_LIVE_AUDIT:-0}" != 1 ]]; then
    printf '%s AIO session-start mode=%s events=log\n' "$(date -u +%Y-%m-%dT%H:%M:%S.%6NZ)" "$mode" >> "$logs/$name.log"
    export RUST_LOG="${RUST_LOG:-warn,nono_proxy::audit=info}"
  fi
  cmd+=(--log-file "$logs/$name.log")
fi
[[ -n "$WS_MEMORY" ]] && cmd+=(--memory "$WS_MEMORY")
[[ "$WS_PIDS" != 0 ]] && cmd+=(--max-processes "$WS_PIDS")
case $mode in
  claude) cmd+=(-- claude ${WS_PROMPT:+--append-system-prompt "$WS_PROMPT"} "$@"); unit="claude-$name-$$" ;;
  shell)  cmd+=(-- bash -l); unit="shell-$name-$$" ;;
  exec)   cmd+=(-- sh -c "${1:?--exec needs a command}"); unit="exec-$name-$$" ;;
esac

cd "$WS_DIR"
# Run in a scope of the user's systemd instance (needs lingering, so it
# exists without a login): nono's limits need that delegated cgroup, and
# the metrics exporter reads usage from it (claude-<workspace>-<pid>.scope).
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus}"
if systemctl --user show-environment >/dev/null 2>&1; then
  exec systemd-run --user --scope --quiet --collect --unit "$unit" -- "${cmd[@]}"
fi
if [[ -n "$WS_MEMORY" || "$WS_PIDS" != 0 ]]; then
  echo "No systemd --user instance: can't apply this workspace's resource limits." >&2
  exit 1
fi
exec "${cmd[@]}"
