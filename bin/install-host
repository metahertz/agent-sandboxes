#!/usr/bin/env bash
# Set up agent-sandboxes on a fresh Ubuntu host (24.04 or later), e.g. a test
# machine. Run it on the host as the user that will own the setup (not root;
# it uses sudo), or from another machine over SSH:
#
#   bin/install-host [options]                    on the host itself
#   bin/install-host --ssh user@host [options]    copies itself there and runs it
#
# Options:
#   --branch NAME    the git branch to install (default: main)
#   --repo URL       the repository (default: https://github.com/metahertz/agent-sandboxes.git)
#   --hermes         also install Hermes Agent (bin/install-hermes) and its nono profile
#   --microvm        also set up microVM workspaces: QEMU, virtiofsd, the kvm group,
#                    and build the base image (bin/microvm-image, several minutes)
#   --no-claude      don't install Claude Code
#   --no-image       don't pull the AIO sandbox image now (about 13 GB; the first
#                    workspace pulls it otherwise)
#
# What it does: apt packages (Docker, tmux, python3, …), nono from its GitHub
# release (checksum verified), the clone at ~/agent-sandboxes, nono's profiles
# and hook, the system units rendered for this user (bin/render-host-file),
# PAM sign-in, lingering for your systemd --user instance, and starts the
# services. Re-running it is safe: it skips what's done and updates the rest.
# Later updates: bin/update-host (or the web UI's Host page).
set -euo pipefail

REPO=https://github.com/metahertz/agent-sandboxes.git
BRANCH=main
HERMES=0 MICROVM=0 CLAUDE=1 IMAGE=1 SSH_TARGET=""
args=("$@")
while [[ $# -gt 0 ]]; do
  case $1 in
    --ssh) SSH_TARGET=${2:?--ssh needs user@host}; shift 2 ;;
    --branch) BRANCH=${2:?--branch needs a name}; shift 2 ;;
    --repo) REPO=${2:?--repo needs a URL}; shift 2 ;;
    --hermes) HERMES=1; shift ;;
    --microvm) MICROVM=1; shift ;;
    --no-claude) CLAUDE=0; shift ;;
    --no-image) IMAGE=0; shift ;;
    -h|--help) sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
    *) echo "Unknown option: $1 (see --help)" >&2; exit 2 ;;
  esac
done

if [[ -n $SSH_TARGET ]]; then
  # Run this same script there (minus --ssh), with a terminal for sudo's prompt
  rest=()
  for ((i = 0; i < ${#args[@]}; i++)); do
    if [[ ${args[i]} == --ssh ]]; then ((i++)) || true; continue; fi
    rest+=("${args[i]}")
  done
  remote=$(ssh "$SSH_TARGET" 'mktemp /tmp/aio-install-host.XXXXXX')
  ssh "$SSH_TARGET" "cat > $remote && chmod 700 $remote" < "$0"
  exec ssh -t "$SSH_TARGET" "$remote $(printf '%q ' "${rest[@]}"); rc=\$?; rm -f $remote; exit \$rc"
fi

say() { printf '\033[1m==> %s\033[0m\n' "$*"; }
note() { printf '\033[33m    %s\033[0m\n' "$*"; }
die() { printf '\033[31m%s\033[0m\n' "$*" >&2; exit 1; }

[[ $(id -u) != 0 ]] || die "Run this as the user who'll own the setup, not root (it uses sudo)."
. /etc/os-release
[[ ${ID:-} == ubuntu ]] || die "This script is for Ubuntu (found ${PRETTY_NAME:-unknown})."
command -v sudo >/dev/null || die "sudo is missing."
sudo -v

ROOT="$HOME/agent-sandboxes"
export AIO_ROOT="$ROOT"
arch=$(dpkg --print-architecture)
kernel=$(uname -r | cut -d. -f1,2)
if [[ $(printf '%s\n%s\n' "$kernel" 6.7 | sort -V | head -1) != 6.7 ]]; then
  note "Kernel $kernel: nono needs Landlock ABI 4 (Linux 6.7+) for its network rules; sandboxes may not start."
fi
grep -qw landlock /sys/kernel/security/lsm 2>/dev/null || \
  note "Landlock isn't in the active LSMs (/sys/kernel/security/lsm): nono can't sandbox without it."

say "Packages"
pkgs=(git curl ca-certificates jq tmux python3 openssl iproute2 rsync docker.io docker-compose-v2
      smbclient zstd uidmap)
(( MICROVM )) && pkgs+=(qemu-system-x86 virtiofsd mmdebstrap e2fsprogs)
sudo DEBIAN_FRONTEND=noninteractive apt-get update -q
sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -q "${pkgs[@]}"
sudo systemctl enable --now docker
groups=(docker); (( MICROVM )) && groups+=(kvm)
for g in "${groups[@]}"; do
  id -nG | tr ' ' '\n' | grep -qx "$g" || sudo usermod -aG "$g" "$USER"
done

say "nono"
if ! command -v nono >/dev/null; then
  rel=$(curl -fsSL https://api.github.com/repos/nolabs-ai/nono/releases/latest)
  tag=$(jq -r .tag_name <<<"$rel")
  deb="nono-cli_${tag#v}_${arch}.deb"
  tmp=$(mktemp -d)
  curl -fsSL -o "$tmp/$deb" "https://github.com/nolabs-ai/nono/releases/download/$tag/$deb"
  curl -fsSL -o "$tmp/SHA256SUMS.txt" "https://github.com/nolabs-ai/nono/releases/download/$tag/SHA256SUMS.txt"
  (cd "$tmp" && grep " $deb\$" SHA256SUMS.txt | sha256sum -c -) || die "nono's checksum didn't match"
  sudo apt-get install -y -q "$tmp/$deb"
  rm -rf "$tmp"
fi
nono --version

say "agent-sandboxes ($BRANCH) in $ROOT"
if [[ -d $ROOT/.git ]]; then
  git -C "$ROOT" fetch -q origin "$BRANCH"
  git -C "$ROOT" checkout -q "$BRANCH"
  git -C "$ROOT" pull -q --ff-only origin "$BRANCH"
else
  git clone -q --branch "$BRANCH" "$REPO" "$ROOT"
fi
cd "$ROOT"
git log -1 --format='    %h %s'

if (( CLAUDE )) && [[ ! -x $HOME/.local/bin/claude ]]; then
  say "Claude Code"
  curl -fsSL https://claude.ai/install.sh | bash
fi

say "nono profiles and hook"
mkdir -p ~/.config/nono/profiles ~/.config/nono/hooks
nono pull nolabs-ai/claude || note "nono pull nolabs-ai/claude failed; run it again later"
bin/render-host-file nono/claude-browser.jsonc > ~/.config/nono/profiles/claude-browser.jsonc
cp nono/hermes-sandbox.jsonc ~/.config/nono/profiles/
install -m 700 nono/aio-env.sh ~/.config/nono/hooks/

say "System services (as $USER)"
for u in agent-sandboxes-ui agent-sandboxes-proxy; do
  bin/render-host-file "systemd/$u.service" | sudo tee "/etc/systemd/system/$u.service" >/dev/null
done
sudo install -m 644 pam.d/agent-sandboxes /etc/pam.d/
sudo loginctl enable-linger "$USER"
sudo systemctl daemon-reload
mkdir -p monitoring/data/nono-logs ~/.local/state/nono
sudo systemctl enable --now agent-sandboxes-proxy agent-sandboxes-ui

if (( IMAGE )); then
  image=$(sed -n 's/^\s*image:\s*\(\S\+\).*/\1/p' compose.workspace.yaml | head -1)
  say "Pulling $image (large; --no-image skips this)"
  sudo docker pull -q "$image"
fi

if (( HERMES )); then
  say "Hermes Agent"
  bin/install-hermes
fi

if (( MICROVM )); then
  say "MicroVM base image"
  [[ -e /dev/kvm ]] || note "/dev/kvm is missing: enable (nested) virtualisation for microVM workspaces."
  sg kvm -c bin/microvm-image
fi

for _ in $(seq 1 15); do [[ -s ui/tls/ca.crt ]] && break; sleep 1; done    # the UI makes its CA at first start
ip=$(ip -4 route get 192.0.2.1 2>/dev/null | grep -oP 'src \K\S+' || hostname -I | awk '{print $1}')
fp=$(openssl x509 -in ui/tls/ca.crt -noout -fingerprint -sha256 2>/dev/null | cut -d= -f2 || true)
say "Done"
cat <<EOF
    Open https://$ip/ and sign in as $USER with your password (then add passkeys under Settings).
    First, trust this host's CA on the machine you browse from: https://$ip/ca.crt
    ${fp:+(SHA-256 $fp)}
    Firewall, if ufw is on: sudo ufw allow from <your-subnet> to any port 443,9101:9199 proto tcp
    Log out and back in (or reconnect over SSH) for the docker group in your own shells.
    Updates: bin/update-host, or the web UI's Host page.
EOF
