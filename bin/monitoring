#!/usr/bin/env bash
# Monitoring for Agent Sandboxes (monitoring/compose.yaml + ui/exporter.py).
#
#   monitoring up        set up on first run, start the stack and the exporter
#   monitoring init      set up only (monitoring/.env, password, exporter unit)
#   monitoring down      stop both (data is kept)
#   monitoring status    containers, exporter, Grafana URL
#   monitoring logs [service]
#   monitoring password  print Grafana's admin password
#
# The web UI's Settings page edits monitoring/.env and runs up / down.
# Once it's set up, Claude sessions started from then on send their
# telemetry to Alloy (unless CLAUDE_TELEMETRY=0).
set -euo pipefail

ROOT="${AIO_ROOT:-$HOME/agent-sandboxes}"
MON="$ROOT/monitoring"
ENV_FILE="$MON/.env"
PW_FILE="$ROOT/secrets/grafana-admin-password"
UNIT=agent-sandboxes-exporter.service
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus}"

setting() {
  # shellcheck disable=SC1090
  (source "$ENV_FILE"; eval "echo \"\${$1:-$2}\"")
}

# with the local stack's services only when MON_STACK=1 (or "all")
compose() {
  local profile=()
  [[ "${STACK:-$(setting MON_STACK 1)}" != 0 ]] && profile=(--profile stack)
  docker compose --env-file "$ENV_FILE" -f "$MON/compose.yaml" "${profile[@]}" "$@"
}

setup() {
  umask 077
  mkdir -p "$MON/data/grafana" "$MON/data/exporter" "$ROOT/secrets"
  [[ -s "$PW_FILE" ]] || openssl rand -base64 18 | tr -d '\n' > "$PW_FILE"
  if [[ ! -f "$ENV_FILE" ]]; then
    local ip domain
    ip="$(ip -4 route get 192.0.2.1 2>/dev/null | grep -oP 'src \K\S+' || true)"
    # the UI certificate's public name, if one is configured
    domain="$(grep -v '^#' "$ROOT/ui/extra-hostnames" 2>/dev/null | grep -m1 '\.' || hostname -f)"
    cat > "$ENV_FILE" <<CONF
# bin/monitoring settings (docker compose --env-file). Edit, then: monitoring up
MON_UID=$(id -u)
MON_GID=$(id -g)
HOST_NAME=$(hostname -s)
# Grafana: https://GRAFANA_DOMAIN:GRAFANA_PORT/ with the UI's certificate
GRAFANA_BIND=${ip:-127.0.0.1}
GRAFANA_PORT=3000
GRAFANA_DOMAIN=${domain}
# Dashboards link on the web UI's Settings page; point it at an external
# Grafana if you use one.
MONITORING_URL=https://${domain}:3000/
# 1 = Claude Code sends OpenTelemetry to Alloy (restart Claude to apply)
CLAUDE_TELEMETRY=1
# 1 = run Prometheus, Loki and Grafana here. 0 = only Alloy, shipping to:
MON_STACK=1
#PROM_WRITE_URL=https://prometheus.example/api/v1/write
#LOKI_URL=https://loki.example
PROM_RETENTION=30d
PROM_RETENTION_SIZE=5GB
LOKI_RETENTION=336h
CONF
  fi
  # settings added since an existing .env was written
  grep -q '^#\{0,1\}MONITORING_URL=' "$ENV_FILE" ||
    printf '# Dashboards link on the web UI Settings page\nMONITORING_URL=https://%s:%s/\n' \
      "$(setting GRAFANA_DOMAIN localhost)" "$(setting GRAFANA_PORT 3000)" >> "$ENV_FILE"
  grep -q '^#\{0,1\}CLAUDE_TELEMETRY=' "$ENV_FILE" ||
    printf '# 1 = Claude Code sends OpenTelemetry to Alloy\nCLAUDE_TELEMETRY=1\n' >> "$ENV_FILE"
  install -Dm644 "$ROOT/systemd/$UNIT" "$HOME/.config/systemd/user/$UNIT"
  systemctl --user daemon-reload
}

url() {
  if [[ "$(setting MON_STACK 1)" != 0 ]]; then
    echo "Grafana: https://$(setting GRAFANA_DOMAIN localhost):$(setting GRAFANA_PORT 3000)/  (user admin, password: monitoring password)"
  else
    echo "External: metrics -> $(setting PROM_WRITE_URL), logs -> $(setting LOKI_URL)"
  fi
  echo "Dashboards link: $(setting MONITORING_URL '<none>')"
}

case "${1:-status}" in
  up)
    setup
    compose up -d --remove-orphans
    if [[ "$(setting MON_STACK 1)" == 0 ]]; then   # switched to external: drop the local stack (data kept)
      STACK=1 compose rm -sf prometheus loki grafana
    fi
    systemctl --user enable --now "$UNIT"
    systemctl --user restart "$UNIT"
    url
    echo "Claude sessions started from now on report telemetry; restart running ones to include them."
    ;;
  down)
    systemctl --user disable --now "$UNIT" 2>/dev/null || true
    [[ -f "$ENV_FILE" ]] && STACK=1 compose down
    ;;
  status)
    [[ -f "$ENV_FILE" ]] || { echo "Not set up yet: monitoring up"; exit 0; }
    compose ps --format 'table {{.Name}}\t{{.Status}}'
    echo "exporter: $(systemctl --user is-active "$UNIT" 2>/dev/null || true)"
    url
    ;;
  logs)
    shift; compose logs --tail 100 -f "$@"
    ;;
  init)
    setup
    ;;
  password)
    cat "$PW_FILE"; echo
    ;;
  *)
    sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 2
    ;;
esac
